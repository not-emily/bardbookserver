#!/usr/bin/env bash
# Install bard as a systemd service. Run as root.
#
#   sudo ./scripts/install              # build from source and install
#   sudo ./scripts/install ./bard-linux-amd64
#
# Re-running upgrades the binary and leaves the config and data alone.
set -euo pipefail

BIN_DEST=/usr/local/bin/bard
CONFIG_DIR=/etc/bard
CONFIG=$CONFIG_DIR/bard.yml
DATA_DIR=/var/lib/bard
UNIT=/etc/systemd/system/bard.service
SERVICE_USER=bard

say() { printf '\033[0;32m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*" >&2; }
die() {
	printf '\033[0;31minstall: %s\033[0m\n' "$*" >&2
	exit 1
}

[[ $EUID -eq 0 ]] || die "run as root (sudo ./scripts/install)"
command -v systemctl >/dev/null || die "this installer targets systemd"

cd "$(dirname "${BASH_SOURCE[0]}")/.."
REPO=$PWD

BINARY=${1:-}
if [[ -z $BINARY ]]; then
	command -v go >/dev/null || die "no binary given and go is not installed"
	say "Building from source..."
	# Build as the invoking user so the module cache does not end up root-owned.
	if [[ -n ${SUDO_USER:-} ]]; then
		sudo -u "$SUDO_USER" ./scripts/build /tmp/bard-install-build
	else
		./scripts/build /tmp/bard-install-build
	fi
	BINARY=/tmp/bard-install-build
fi
[[ -f $BINARY ]] || die "$BINARY does not exist"

UNIT_SRC=$REPO/packaging/systemd/bard.service
[[ -f $UNIT_SRC ]] || die "$UNIT_SRC is missing"

say "Creating the $SERVICE_USER service account..."
if ! getent passwd "$SERVICE_USER" >/dev/null; then
	useradd --system --home-dir "$DATA_DIR" --shell /usr/sbin/nologin "$SERVICE_USER"
fi

say "Creating directories..."
install -d -m 0755 "$CONFIG_DIR"
install -d -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0750 "$DATA_DIR"

say "Installing the binary..."
install -m 0755 "$BINARY" "$BIN_DEST"

FRESH_CONFIG=false
if [[ ! -f $CONFIG ]]; then
	FRESH_CONFIG=true
	say "Writing $CONFIG..."
	cat >"$CONFIG" <<-YAML
		data_dir: $DATA_DIR
		bind_addr: 127.0.0.1
		port: 2273

		# THE MOST IMPORTANT LINE IN THIS FILE.
		#
		# The addresses Bard will believe an X-Forwarded-For header from. Leave
		# it empty and every client behind a tunnel or proxy shares one
		# rate-limit bucket; set it too wide and a caller can spoof its address
		# past login rate limiting.
		#
		# Behind cloudflared or a reverse proxy on this host: ["127.0.0.1/32"]
		# Exposed directly with no proxy:                      []
		#
		# docs/deploy/ states the value for each recipe, and /diagnostics in the
		# admin UI shows what Bard actually resolves for your requests.
		trusted_proxies: []

		workers: 2
		log_level: info

		tls:
		  mode: "off"

		backup:
		  enabled: true
		  interval_hours: 24
		  keep: 7
	YAML
	chown root:"$SERVICE_USER" "$CONFIG"
	chmod 0640 "$CONFIG"
else
	say "Keeping the existing $CONFIG."
fi

say "Installing the systemd unit..."
install -m 0644 "$UNIT_SRC" "$UNIT"
systemctl daemon-reload

say "Enabling and starting bard..."
systemctl enable bard >/dev/null
systemctl restart bard

sleep 1
if ! systemctl is-active --quiet bard; then
	warn "bard did not stay running. Recent log:"
	journalctl -u bard -n 20 --no-pager >&2 || true
	exit 1
fi

VERSION=$("$BIN_DEST" version 2>/dev/null || echo unknown)
say ""
say "=== bard $VERSION is running ==="
cat <<EOF

  Status:  systemctl status bard
  Logs:    journalctl -u bard -f
  Config:  $CONFIG
  Data:    $DATA_DIR

It is bound to 127.0.0.1:2273, which is reachable only from this host. Pick a
recipe in docs/deploy/ to reach it from anywhere else; each one states the
trusted_proxies value it needs.

Open http://127.0.0.1:2273/ to create the first admin account.
EOF

if [[ $FRESH_CONFIG == true ]]; then
	warn ""
	warn "trusted_proxies is empty. That is correct for a directly exposed"
	warn "server and wrong behind a tunnel or proxy, where it collapses every"
	warn "client into one rate-limit bucket. Check /diagnostics once you can"
	warn "reach the UI through whatever fronts it."
fi

if [[ $BINARY == /tmp/bard-install-build ]]; then
	rm -f "$BINARY"
fi
